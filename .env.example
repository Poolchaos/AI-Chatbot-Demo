# LLM Provider: "gemini" or "claude"
LLM_PROVIDER=gemini

# Google AI Studio API key (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic API key (required if LLM_PROVIDER=claude)
CLAUDE_API_KEY=

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/elevate-offsites

# Max LLM API requests per day (default: 1500)
DAILY_REQUEST_LIMIT=1500

# Max messages per chat session (default: 20)
SESSION_MESSAGE_LIMIT=20

# Enable demo reset endpoint in production (default: false)
DEMO_MODE=false
